# --- General ---
PROJECT_NAME=ProxyOps
ENVIRONMENT=development

# --- Database ---
POSTGRES_USER=proxyops
POSTGRES_PASSWORD=proxyops
POSTGRES_DB=proxyops
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Backend ---
# 256-bit hex string — generate with:  python -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=replace-me-with-a-real-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# Seeded admin (created on first boot if no user exists)
FIRST_ADMIN_EMAIL=admin@proxyops.io
FIRST_ADMIN_PASSWORD=changeme

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000/api/v1
